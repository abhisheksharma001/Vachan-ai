# ════════════════════════════════════════════════════════════════
# Vachan.ai — environment template.  Copy to `.env` and fill in.
# `.env` is git-ignored. NEVER commit real keys.
# ════════════════════════════════════════════════════════════════

# ─── Runtime ──────────────────────────────────────────────
# 'development' | 'production'. Controls safety guards (see auth below).
ENV=development

# ─── Postgres ─────────────────────────────────────────────
# TWO ROLES by design (migration 0001 creates the app role):
#   DATABASE_URL      → app role `vachan_app` — RLS APPLIES (the request path).
#   DATABASE_URL_SYNC → owner role `vachan`   — migrations + provisioning.
# The owner bypasses RLS (so it can create orgs/users); the app role cannot.
# Ports match docker-compose defaults (5433/6380, chosen to avoid clashing
# with a system Postgres/Redis). Override with DB_PORT/REDIS_PORT below —
# docker compose reads them from this same file.
DATABASE_URL=postgresql+psycopg://vachan_app:vachan_app@localhost:5433/vachan
DATABASE_URL_SYNC=postgresql+psycopg://vachan:vachan@localhost:5433/vachan
# DB_PORT=5433

# ─── Redis (session cache) ────────────────────────────────
REDIS_URL=redis://localhost:6380/0
# REDIS_PORT=6380

# ─── LLM provider keys (LiteLLM reads these) ──────────────
# Any ONE provider key makes the gateway live. Groq is the first wired+verified
# backend (hosts the Hinglish Qwen3→Llama 4 fallback chain + Whisper).
# Sarvam + Kimi stay unwired until their model IDs are confirmed.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=
KIMI_API_KEY=

# ─── Auth ─────────────────────────────────────────────────
# 'provider'  → verify JWTs issued by a managed provider (Supabase/Clerk/Auth.js).
#               This is the PRODUCTION setting (FD: do not hand-roll issuance).
# 'dev'       → use the local DEV-ONLY issuer for testing. REFUSED when ENV=production.
AUTH_MODE=dev

# -- when AUTH_MODE=provider, set the provider's verification params --
# (Abhishek picks the provider, then supplies these.)
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# -- when AUTH_MODE=dev, the local issuer signs with this HS256 secret --
# Any non-empty string works for local testing. Ignored in production.
AUTH_DEV_SECRET=dev-only-change-me

# ════════════════════════════════════════════════════════════════
# Frontend (server-side only, copy to frontend/.env.local)
# ════════════════════════════════════════════════════════════════
# The Next.js BFF reads this to reach the FastAPI backend.
# Use 127.0.0.1 (not localhost) when the backend binds to IPv4.
# BACKEND_URL=http://127.0.0.1:8000
