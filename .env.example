# ════════════════════════════════════════════════════════════════
# Vachan.ai — environment template.  Copy to `.env` and fill in.
# `.env` is git-ignored. NEVER commit real keys.
# ════════════════════════════════════════════════════════════════

# ─── Runtime ──────────────────────────────────────────────
# 'development' | 'production'. Controls safety guards (see auth below).
ENV=development

# ─── Postgres (the docker-compose service is reachable at host 'db') ─
# Async URL is used by the FastAPI app; the sync URL is used by Alembic.
DATABASE_URL=postgresql+psycopg://vachan:vachan@localhost:5432/vachan
DATABASE_URL_SYNC=postgresql+psycopg://vachan:vachan@localhost:5432/vachan

# ─── Redis (session cache) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── LLM provider keys (LiteLLM reads these) ──────────────
# Phase 0 needs only ANTHROPIC to satisfy the /health litellm check.
# Sarvam + Kimi are wired but optional until their phase.
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
KIMI_API_KEY=

# ─── Auth ─────────────────────────────────────────────────
# 'provider'  → verify JWTs issued by a managed provider (Supabase/Clerk/Auth.js).
#               This is the PRODUCTION setting (FD: do not hand-roll issuance).
# 'dev'       → use the local DEV-ONLY issuer for testing. REFUSED when ENV=production.
AUTH_MODE=dev

# -- when AUTH_MODE=provider, set the provider's verification params --
# (Abhishek picks the provider, then supplies these.)
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# -- when AUTH_MODE=dev, the local issuer signs with this HS256 secret --
# Any non-empty string works for local testing. Ignored in production.
AUTH_DEV_SECRET=dev-only-change-me
